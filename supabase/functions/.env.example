# LLM providers for the in-game coach. Configure at least one.
# These are SERVER-SIDE only — never prefix them with VITE_, or they end up in
# the browser bundle where anyone can read them.

# Order to try. Unlisted providers are appended, so adding a key always works.
LLM_PROVIDER_ORDER=fastrouter,gemini,sarvam,anthropic

# FastRouter — OpenAI-compatible router, one key for many upstream models.
FASTROUTER_API_KEY=
FASTROUTER_MODEL=openai/gpt-4o-mini
FASTROUTER_BASE_URL=https://go.fastrouter.ai/api/v1

# Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Sarvam AI — OpenAI-compatible.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# Anthropic Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Lock CORS to your deployed origin in production.
ALLOWED_ORIGIN=*
